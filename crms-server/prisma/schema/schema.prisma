generator client {
  provider = "prisma-client"
  output = "../generated-v2"
}
datasource db {
  provider = "postgresql"
}
model ClientCompany {
  id String @id @default(uuid())
  name String
  billingTier String?
  monthlyQuotaHrs Float @default(0)
  timezone String @default("UTC")
  status String @default("ACTIVE")
  users User[]
  reservations Reservation[]
  usageLogs UsageLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
model User {
  id String @id @default(uuid())
  email String @unique
  phone String? @unique
  name String
  passwordHash String
  role String @default("MEMBER")
  departmentCode String?
  isActive Boolean @default(true)
  companyId String
  company ClientCompany @relation(fields: [companyId], references: [id])
  reservations Reservation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
model ConferenceRoom {
  id String @id @default(uuid())
  name String
  capacity Int
  equipmentList String[] @default([])
  description String?
  location String?
  hourlyRate Float @default(0)
  isActive Boolean @default(true)
  reservations Reservation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  maintenanceSchedules MaintenanceSchedule[]
}
model Reservation {
  id String @id @default(uuid())
  clientId String
  userId String
  roomId String
  type String
  status String @default("PENDING")
  scheduledStart DateTime
  scheduledEnd DateTime
  actualCheckIn DateTime?
  actualCheckOut DateTime?
  cancellationReason String?
  cancelledAt DateTime?
  extensionMinutes Int @default(0)
  client ClientCompany @relation(fields: [clientId], references: [id])
  user User @relation(fields: [userId], references: [id])
  room ConferenceRoom @relation(fields: [roomId], references: [id])
  usageLog UsageLog?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([roomId, scheduledStart, scheduledEnd])
}
model UsageLog {
  id String @id @default(uuid())
  reservationId String @unique
  clientId String
  userId String
  roomId String
  scheduledStart DateTime
  scheduledEnd DateTime
  startTime DateTime
  endTime DateTime?
  scheduledMinutes Int
  actualConsumedMinutes Int @default(0)
  billableMins Int @default(0)
  overstayMinutes Int @default(0)
  billingAmount Float @default(0)
  overstayed Boolean @default(false)
  reservation Reservation @relation(fields: [reservationId], references: [id])
  client ClientCompany @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())
}

model MaintenanceSchedule {
  id String @id @default(uuid())
  roomId String
  startTime DateTime
  endTime DateTime
  reason String?
  room ConferenceRoom @relation(fields: [roomId], references: [id])
  createdAt DateTime @default(now())
  @@index([roomId, startTime, endTime])
}

model AuditLog {
  id String @id @default(uuid())
  actorId String?
  actorRole String?
  entityType String
  entityId String
  action String
  previousData Json?
  newData Json?
  reason String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AuditEntry {
 id String @id @default(uuid())
 actorId String
 action String
 resourceId String
 details Json
 createdAt DateTime @default(now())
}
