NODE_ENV=development
HOST=0.0.0.0
PORT=5000
CLIENT_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/crms
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=crms_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Production values must be changed during deployment.
# NODE_ENV=production
# CLIENT_URL=https://your-domain.com
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# DATABASE_URL=postgresql://user:password@host:5432/crms
# JWT_SECRET=replace-this-in-production
# COOKIE_SECURE=true
